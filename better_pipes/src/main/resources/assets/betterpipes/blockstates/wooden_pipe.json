{
    "multipart": [
        {
            "when": { "up": "connection" },
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_transparent" }
        },
        {
            "when": { "up": "extraction" },
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_solid" }
        },
        {
            "when": { "up": "structure" },
            "apply": { "model": "betterpipes:block/wooden_pipe_structure" }
        },
        {
            "when": { "up": "none"},
            "apply": { "model": "betterpipes:block/wooden_pipe_transparent" }
        },


        {
            "when": { "down": "connection" },
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_transparent" , "x": 180}
        },
        {
            "when": { "down": "structure" },
            "apply": { "model": "betterpipes:block/wooden_pipe_structure", "x" :  180}
        },
        {
            "when": { "down": "extraction" },
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_solid" , "x": 180}
        },
        {
            "when": { "down": "none"},
            "apply": { "model": "betterpipes:block/wooden_pipe_transparent" , "x": 180}
        },


        {
            "when": { "east": "connection"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_transparent" , "x": 90, "y": 90}
        },
        {
            "when": { "east": "extraction"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_solid" , "x": 90,"y": 90}
        },
        {
            "when": { "east": "structure" },
            "apply": { "model": "betterpipes:block/wooden_pipe_structure" , "x": 90,"y": 90}
        },
        {
            "when": { "east": "none"},
            "apply": { "model": "betterpipes:block/wooden_pipe_transparent" , "x": 90,"y": 90}
        },



        {
            "when": { "west": "connection"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_transparent" , "x": 90,"y": 270}
        },
        {
            "when": { "west": "extraction"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_solid" , "x": 90,"y": 270}
        },
        {
            "when": { "west": "structure" },
            "apply": { "model": "betterpipes:block/wooden_pipe_structure" , "x": 90,"y": 270}
        },
        {
            "when": { "west": "none"},
            "apply": { "model": "betterpipes:block/wooden_pipe_transparent" , "x": 90,"y": 270}
        },



        {
            "when": { "south": "connection"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_transparent" , "x": 90,"y": 180}
        },
        {
            "when": { "south": "extraction"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_solid" , "x": 90,"y": 180}
        },
        {
            "when": { "south": "structure" },
            "apply": { "model": "betterpipes:block/wooden_pipe_structure" , "x": 90,"y": 180}
        },
        {
            "when": { "south": "none"},
            "apply": { "model": "betterpipes:block/wooden_pipe_transparent" , "x": 90,"y": 180}
        },



        {
            "when": { "north": "connection"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_transparent" , "x": 90,"y": 0}
        },
        {
            "when": { "north": "extraction"},
            "apply": { "model": "betterpipes:block/wooden_pipe_connection_solid" , "x": 90,"y": 0}
        },
        {
            "when": { "north": "structure" },
            "apply": { "model": "betterpipes:block/wooden_pipe_structure" , "x": 90,"y": 0}
        },
        {
            "when": { "north": "none"},
            "apply": { "model": "betterpipes:block/wooden_pipe_transparent" , "x": 90,"y": 0}
        }
    ]
}
