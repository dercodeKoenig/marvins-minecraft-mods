{
  "multipart": [
    {
      "when": {
        "connected_down": false,
        "connected_up": false
      },
      "apply": {
        "model": "betterpipes:block/tank"
      }
    },
    {
      "when": {
        "connected_down": true,
        "connected_up": false
      },
      "apply": {
        "model": "betterpipes:block/tank_joined_below"
      }
    },
    {
      "when": {
        "connected_down": false,
        "connected_up": true
      },
      "apply": {
        "model": "betterpipes:block/tank_joined_above"
      }
    },
    {
      "when": {
        "connected_down": true,
        "connected_up": true
      },
      "apply": {
        "model": "betterpipes:block/tank_joined_all"
      }
    },
    

    {
      "when": { "c_north": 1},
      "apply": { "model": "betterpipes:block/pipe_connection_solid_extended" , "x": 90,"y": 0}
    },
    {
      "when": { "c_south": 1},
      "apply": { "model": "betterpipes:block/pipe_connection_solid_extended" , "x": 90,"y": 180}
    },
    {
      "when": { "c_east": 1},
      "apply": { "model": "betterpipes:block/pipe_connection_solid_extended" , "x": 90,"y": 90}
    },
    {
      "when": { "c_west": 1},
      "apply": { "model": "betterpipes:block/pipe_connection_solid_extended" , "x": 90,"y": 270}
    }
  ]
}
